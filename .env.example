# LLM: any OpenAI-compatible endpoint (OpenAI, Groq, OpenRouter, Together, Ollama, vLLM)
MERIDIAN_LLM_BASE_URL=
MERIDIAN_LLM_API_KEY=sk-...
MERIDIAN_LLM_MODEL=gpt-4.1-mini
# Optional cheaper model for the high-volume extraction step
MERIDIAN_FAST_MODEL=gpt-4.1-nano

# Search: tavily | brave | serper | duckduckgo (no key) | local (offline synthetic web)
MERIDIAN_SEARCH_PROVIDER=duckduckgo
MERIDIAN_SEARCH_API_KEY=

# Depth and budgets
MERIDIAN_MAX_SUB_QUESTIONS=5
MERIDIAN_SOURCES_PER_SUB_QUESTION=4
MERIDIAN_MAX_ROUNDS=2
MERIDIAN_MAX_LLM_CALLS=120
MERIDIAN_MAX_COST_USD=1.00
MERIDIAN_MAX_SECONDS=600
